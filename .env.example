# Required: long random string used to sign login sessions.
#   Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Required: one-time code you type when registering a new device.
#   Pick anything long; only you should know it.
SETUP_CODE=

# Optional: max passkeys per person (default 2: laptop + phone).
MAX_DEVICES=2

# Storage: added automatically when you connect Upstash Redis in Vercel
# (Storage tab -> Upstash for Redis). Either naming works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
